*.dll
*.exe
.DS_Store
example.tf
terraform.tfplan
bin/
dist/
modules-dev/
/pkg/
website/.vagrant
website/.bundle
website/build
website/node_modules
.vagrant/
*.log
*.bak
*~
.*.swp
.idea
*.iml
*.test
terraform-provider-uem*
.env

# Terraform state files (should NEVER be in repository)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json
!examples/**/*.tfvars.example

# Allow .tf files only in examples/ and internal/
*.tf
!examples/**/*.tf
!internal/**/*.tf
# Exclude temporary import resource files generated by import-profiles.sh
examples/**/import-temp-*.tf

# Output directory (except documentation)
output/
!output/*.md
coverage.out
website/vendor

# Test exclusions
!command/test-fixtures/**/*.tfstate
!command/test-fixtures/**/.terraform/

# Keep windows files with windows line endings
*.winfile eol=crlf

# Go workspace (local SDK development — created by 'make dev-mode')
go.work
go.work.sum

# build artifacts
terraform-provider-uem
